@{
    ViewData["Title"] = "Editar Producto"; var prod = ViewBag.Producto;
}
<div class="container mt-4">
    <h2>Editar Producto</h2>
    <form asp-action="Edit" method="post">
        <input type="hidden" name="id" value="@prod["id"]" />
        <input type="text" name="nombre" class="form-control mb-2" value="@prod["nombre"]" required />
        <input type="number" step="0.01" name="precio" class="form-control mb-2" value="@prod["precio"]" required />
        <input type="number" name="stock" class="form-control mb-2" value="@prod["stock"]" required />
        <textarea name="descripcion" class="form-control mb-3">@prod["descripcion"]</textarea>
        <button type="submit" class="btn btn-primary">Actualizar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
</div>